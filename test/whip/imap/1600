CREATE RULE ab_del AS ON DELETE TO ab DO INSTEAD (
    DELETE FROM b WHERE (x=old.x) AND (y=old.y);
    DELETE FROM a WHERE (x=old.x);
);

Anyone has an explanation for this? I'm using PostgreSQL 7.0.3.

