call finalization and some other values to a calls table, called
cham_chamada. Please check this out (very simple) :

------------------------------------------------------------------

CREATE FUNCTION finaliza_chamv2(INT4, INT4, INT4, CHAR(23), CHAR(23),
CHAR(1),
                                INT4, INT4, INT4, CHAR(23), INT4, INT4,
CHAR(25),
                                INT4, INT4, INT4) RETURNS int4 AS
'
DECLARE
  pbxs           ALIAS FOR $1;
  pchave         ALIAS FOR $2;
  pidentificacao ALIAS FOR $3;
  pdtinicial     ALIAS FOR $4;
  pdtfinal       ALIAS FOR $5;
  pflgliber      ALIAS FOR $6;
  ptempototal    ALIAS FOR $7;
  pcodliber      ALIAS FOR $8;
  pddd           ALIAS FOR $9;
  pdtocup        ALIAS FOR $10;
  pindicadora    ALIAS FOR $11;
  pcategoria     ALIAS FOR $12;
  pidentidadea   ALIAS FOR $13;
  pfds           ALIAS FOR $14;
  presultcham    ALIAS FOR $15;
  pcifraorigem   ALIAS FOR $16;

BEGIN

  UPDATE cham_chamada
  SET dt_final        =3D TIMESTAMP(pdtfinal),
      flg_liberacao   =3D pflgliber,
      temp_total      =3D ptempototal,
      cod_liberjuntor =3D pcodliber,
      ddd             =3D pddd,
      indicadora      =3D pindicadora,
      cod_categoria   =3D pcategoria,
      identidadea     =3D pidentidadea,
      cod_fds         =3D pfds,
      cod_resultcham  =3D presultcham,
      cifra_origem    =3D pcifraorigem
  WHERE cod_bxs       =3D pbxs           AND
        chave         =3D pchave         AND
        identificacao =3D pidentificacao AND
        dt_inicial    =3D TIMESTAMP(pdtinicial);

  IF pdtocup <> '''' THEN
    UPDATE cham_servico
    SET
      dt_ocupacao =3D TIMESTAMP(pdtocup)
    WHERE
      cod_bxs       =3D pbxs           AND
      chave         =3D pchave         AND
      identificacao =3D pidentificacao AND
      dt_inicial    =3D TIMESTAMP(pdtinicial)     AND
      dt_finalizacao is null;
  END IF;

  RETURN 0;

END;
'
LANGUAGE 'plpgsql';

------------------------------------------------------------------

