# Orig-Date here says "Sat Nov 2026", with no day of the month,
# and Resent-Date below is as bad. Test that aox drops Orig-Date
# and Resent-Date when unusuable, keeps them when usable, and tries
# to repair Date.
depends empty-inbox
send 10
a append inbox () {327+}
Message-Id: <9fa9fe$4f6253@surf91.net.rss.rogers.com>
Date: 07 Nov 2026 23:38:40 -0500
From: BusinessBilling@rci.rogers.com
To: myke@servernorth.net
Orig-Date: Sat Nov 2026 23:40:00 -0500
Subject: =?ISO-8859-1?Q?Bill=20Download=20Request=20Completed?=
Content-Type: text/plain; charset=WE8ISO8859P1

Your bill is ready.
receive 4
* 1 EXISTS
* 1 RECENT
* OK [UIDNEXT 2] next uid
a OK [APPENDUID 1 1] done
# no Orig-Date. Content-Type is dropped as it always is for
# text/plain with an unknown charset, which is unrelated.
send 1
b fetch 1 body.peek[header]
receive 9
* 1 FETCH (BODY[HEADER] {201}
Message-Id: <9fa9fe$4f6253@surf91.net.rss.rogers.com>
Date: Sat, 7 Nov 2026 23:38:40 -0500
From: BusinessBilling@rci.rogers.com
To: myke@servernorth.net
Subject: Bill Download Request Completed

)
b OK done
send 10
c append inbox () {254+}
Message-Id: <valid@example.com>
Date: 07 Nov 2026 23:38:40 -0500
From: BusinessBilling@rci.rogers.com
To: myke@servernorth.net
Orig-Date: Sat, 7 Nov 2026 23:40:00 -0500
Subject: valid orig-date
Content-Type: text/plain; charset=WE8ISO8859P1

body
receive 4
* 2 EXISTS
* 2 RECENT
* OK [UIDNEXT 3] next uid
c OK [APPENDUID 1 2] done
# a date that parses is kept
send 1
d fetch 2 body.peek[header]
receive 10
* 2 FETCH (BODY[HEADER] {206}
Message-Id: <valid@example.com>
Date: Sat, 7 Nov 2026 23:38:40 -0500
From: BusinessBilling@rci.rogers.com
To: myke@servernorth.net
Orig-Date: Sat, 7 Nov 2026 23:40:00 -0500
Subject: valid orig-date

)
d OK done
send 10
e append inbox () {231+}
Message-Id: <resent@example.com>
Date: 07 Nov 2026 23:38:40 -0500
From: BusinessBilling@rci.rogers.com
To: myke@servernorth.net
Resent-Date: Sat Nov 2026 23:40:00 -0500
Resent-From: someone@example.com
Subject: resent

body
receive 4
* 3 EXISTS
* 3 RECENT
* OK [UIDNEXT 4] next uid
e OK [APPENDUID 1 3] done
# Resent-Date goes the same way, and Resent-From stays
send 1
f fetch 3 body.peek[header]
receive 10
* 3 FETCH (BODY[HEADER] {189}
Message-Id: <resent@example.com>
Date: Sat, 7 Nov 2026 23:38:40 -0500
From: BusinessBilling@rci.rogers.com
To: myke@servernorth.net
Resent-From: someone@example.com
Subject: resent

)
f OK done
end
