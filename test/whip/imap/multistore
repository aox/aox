# checks that store doesn't accidentally set flags on neighbouring messages
depends append
send 8
a append INBOX () " 9-feb-2002 12:43:14 +0230" {127+}
From: Arnt Gulbrandsen <arnt@oryx.com>
To: Arnt Gulbrandsen <arnt@oryx.com>
Date: Thu, 20 May 2004 14:28:51 +0200

asdf


receive 4
* 5 EXISTS
* 5 RECENT
* OK [UIDNEXT 6] next uid
a OK [APPENDUID 1 5] done
send 3
0 uid store 1:* -flags.silent \seen
0 uid store 4 +flags.silent \deleted
c uid expunge 4
receive 4
0 OK done
0 OK done
* 4 EXPUNGE
c OK done
send 1
d uid store 1,5 +flags.silent \seen
receive 1
d OK done
send 1
e fetch 1:* flags
receive 5
* 1 FETCH (FLAGS (\Recent \Seen))
* 2 FETCH (FLAGS (\Recent))
* 3 FETCH (FLAGS (\Recent))
* 4 FETCH (FLAGS (\Recent \Seen))
e OK done
send 1
f uid store 4 +flags.silent \seen
receive 1
f OK done
send 1
g uid store 4:5 +flags.silent \seen
receive 1
g OK done
send 1
h store 1,4 +flags.silent \seen
receive 1
h OK done
send 1
i fetch 1:* flags
receive 5
* 1 FETCH (FLAGS (\Recent \Seen))
* 2 FETCH (FLAGS (\Recent))
* 3 FETCH (FLAGS (\Recent))
* 4 FETCH (FLAGS (\Recent \Seen))
i OK done
send 1
j store 3:4 +flags.silent a
# the new flag makes the server re-announce the mailbox flag list
receive 3
* FLAGS (\Answered \Deleted \Draft \Flagged \Seen a)
* OK [PERMANENTFLAGS (\Answered \Deleted \Draft \Flagged \Seen a \*)] permanent flags
j OK done
send 1
k fetch 1:* flags
receive 5
* 1 FETCH (FLAGS (\Recent \Seen))
* 2 FETCH (FLAGS (\Recent))
* 3 FETCH (FLAGS (\Recent a))
* 4 FETCH (FLAGS (\Recent \Seen a))
k OK done
send 1
j uid store 3,5 +flags.silent b
# the new flag makes the server re-announce the mailbox flag list
receive 3
* FLAGS (\Answered \Deleted \Draft \Flagged \Seen a b)
* OK [PERMANENTFLAGS (\Answered \Deleted \Draft \Flagged \Seen a b \*)] permanent flags
j OK done
send 1
l fetch 1:* flags
receive 5
* 1 FETCH (FLAGS (\Recent \Seen))
* 2 FETCH (FLAGS (\Recent))
* 3 FETCH (FLAGS (\Recent a b))
* 4 FETCH (FLAGS (\Recent \Seen a b))
l OK done
send 1
m uid store 1,3 +flags.silent c
# the new flag makes the server re-announce the mailbox flag list
receive 3
* FLAGS (\Answered \Deleted \Draft \Flagged \Seen a b c)
* OK [PERMANENTFLAGS (\Answered \Deleted \Draft \Flagged \Seen a b c \*)] permanent flags
m OK done
send 1
n fetch 1:* flags
receive 5
* 1 FETCH (FLAGS (\Recent \Seen c))
* 2 FETCH (FLAGS (\Recent))
* 3 FETCH (FLAGS (\Recent a b c))
* 4 FETCH (FLAGS (\Recent \Seen a b))
n OK done
end
