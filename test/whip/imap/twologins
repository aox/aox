# Two logged-in connections, so that a test can compare what one
# connection sees with what the other does.
depends login
protocol imap second
receive 1
* OK [CAPABILITY IMAP4rev1 AUTH=ANONYMOUS AUTH=CRAM-MD5 AUTH=DIGEST-MD5 AUTH=PLAIN AUTH=LOGIN COMPRESS=DEFLATE ENABLE ID LITERAL+ SASL-IR STARTTLS] imapscript.test.oryx.com Archiveopteryx IMAP Server (security checking disabled)
send 1
a login script script
receive 1
a OK [CAPABILITY IMAP4rev1 ACL APPENDLIMIT=38400000 BINARY CATENATE CHILDREN COMPRESS=DEFLATE CONDSTORE ENABLE ESEARCH I18NLEVEL=1 ID IDLE LIST-EXTENDED LITERAL+ MOVE MULTIAPPEND NAMESPACE OBJECTID QUOTA RIGHTS=ekntx SPECIAL-USE STARTTLS THREAD=ORDEREDSUBJECT THREAD=REFS THREAD=REFERENCES UIDONLY UIDPLUS UNSELECT URLAUTH UTF8=ACCEPT WITHIN] done
use main
end
